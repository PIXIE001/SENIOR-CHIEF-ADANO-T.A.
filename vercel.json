{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Index.html",
      "use": "@vercel/static"
    },
    {
      "src": "Admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "staff.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/admin",
      "dest": "/Admin.html"
    },
    {
      "src": "/admin.html",
      "dest": "/Admin.html"
    },
    {
      "src": "/staff",
      "dest": "/staff.html"
    },
    {
      "src": "/staff.html",
      "dest": "/staff.html"
    },
    {
      "src": "/",
      "dest": "/Index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
